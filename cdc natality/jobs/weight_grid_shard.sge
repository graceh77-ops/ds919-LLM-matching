#!/bin/bash -l
# Submit an array from "cdc natality": qsub -t 1-N jobs/weight_grid_shard.sge [shard options]
#$ -N natality_grid_shard
#$ -cwd
#$ -V
#$ -pe omp 4
#$ -l h_rt=24:00:00
#$ -l mem_per_core=4G
#$ -o logs/weight_grid_shard.$JOB_ID.$TASK_ID.out
#$ -e logs/weight_grid_shard.$JOB_ID.$TASK_ID.err

set -euo pipefail
module load python3
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
SHARD_INDEX=$((SGE_TASK_ID - 1))
python src/run_weight_grid_shard.py --shard-index "$SHARD_INDEX" \
  --workers "${NSLOTS:-1}" "$@"
