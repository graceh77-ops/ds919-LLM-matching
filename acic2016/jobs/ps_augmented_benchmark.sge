#!/bin/bash -l
# Submit from the repository root after creating ./logs:
# qsub acic2016/jobs/ps_augmented_benchmark.sge [run_full_benchmark.py arguments]
# Raw ACIC data and weight JSON files remain outside Git.
#$ -N acic_psaug_bench
#$ -cwd
#$ -V
#$ -pe omp 1
#$ -l h_rt=72:00:00
#$ -l mem_per_core=4G
#$ -o logs/acic_psaug_bench.$JOB_ID.out
#$ -e logs/acic_psaug_bench.$JOB_ID.err

set -euo pipefail
module load python3
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

python acic2016/src/run_full_benchmark.py "$@"
